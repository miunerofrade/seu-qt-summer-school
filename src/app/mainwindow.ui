      <widget class="QWidget" name="pageSettings">
       <property name="styleSheet">
        <string notr="true">QWidget#pageSettings,
QWidget#settingsScrollContent {
    background-color: #FFFFFF;
}

QLabel#labelSettingsTitle {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QLabel#labelSettingsSubtitle,
QLabel.settingsSecondary {
    color: #6E6E73;
    font-size: 13px;
}

QWidget#settingsDataCard,
QWidget#settingsBackupCard,
QWidget#settingsAboutCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QLabel.settingsSectionTitle {
    color: #1D1D1F;
    font-size: 16px;
    font-weight: 600;
}

QLabel.settingsFieldLabel {
    color: #2F3033;
    font-size: 13px;
    font-weight: 600;
}

QLabel#labelSettingsDataStatus {
    color: #0A7B3E;
    font-weight: 600;
}

QPushButton#btnSaveDataNow {
    background-color: #0A84FF;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    padding: 6px 16px;
}

QPushButton#btnSaveDataNow:hover {
    background-color: #0071E3;
}</string>
       </property>
       <layout class="QVBoxLayout" name="verticalLayoutSettingsPage">
        <property name="spacing"><number>0</number></property><property name="leftMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property>
        <item>
         <widget class="QScrollArea" name="scrollAreaSettings">
          <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
          <property name="widgetResizable"><bool>true</bool></property>
          <widget class="QWidget" name="settingsScrollContent">
           <property name="geometry"><rect><x>0</x><y>0</y><width>800</width><height>700</height></rect></property>
           <layout class="QVBoxLayout" name="verticalLayoutSettingsContent">
            <property name="spacing"><number>16</number></property><property name="leftMargin"><number>24</number></property><property name="topMargin"><number>24</number></property><property name="rightMargin"><number>24</number></property><property name="bottomMargin"><number>24</number></property>
            <item><widget class="QLabel" name="labelSettingsTitle"><property name="text"><string>设置</string></property></widget></item>
            <item><widget class="QLabel" name="labelSettingsSubtitle"><property name="text"><string>管理本地数据、备份恢复与应用信息</string></property></widget></item>
            <item>
             <widget class="QWidget" name="settingsDataCard" native="true">
              <layout class="QVBoxLayout" name="verticalLayoutSettingsDataCard">
               <property name="spacing"><number>12</number></property><property name="leftMargin"><number>20</number></property><property name="topMargin"><number>18</number></property><property name="rightMargin"><number>20</number></property><property name="bottomMargin"><number>18</number></property>
               <item><widget class="QLabel" name="labelSettingsDataTitle"><property name="text"><string>数据管理</string></property><property name="class">settingsSectionTitle</property></widget></item>
               <item>
                <layout class="QGridLayout" name="gridLayoutSettingsData">
                 <property name="horizontalSpacing"><number>16</number></property><property name="verticalSpacing"><number>12</number></property>
                 <item row="0" column="0"><widget class="QLabel" name="labelSettingsDataStatusCaption"><property name="text"><string>本地 JSON 状态</string></property><property name="class">settingsFieldLabel</property></widget></item>
                 <item row="0" column="1"><widget class="QLabel" name="labelSettingsDataStatus"><property name="text"><string>待接入（UI 占位）</string></property></widget></item>
                 <item row="1" column="0"><widget class="QLabel" name="labelSettingsDataFileCaption"><property name="text"><string>数据文件</string></property><property name="class">settingsFieldLabel</property></widget></item>
                 <item row="1" column="1"><widget class="QLabel" name="labelSettingsDataFile"><property name="text"><string>data/app-data.json（占位）</string></property><property name="textInteractionFlags"><set>Qt::TextInteractionFlag::TextSelectableByMouse</set></property><property name="class">settingsSecondary</property></widget></item>
                 <item row="2" column="0"><widget class="QLabel" name="labelSettingsDataDirectoryCaption"><property name="text"><string>数据目录</string></property><property name="class">settingsFieldLabel</property></widget></item>
                 <item row="2" column="1"><widget class="QLabel" name="labelSettingsDataDirectory"><property name="text"><string>data/（占位）</string></property><property name="textInteractionFlags"><set>Qt::TextInteractionFlag::TextSelectableByMouse</set></property><property name="class">settingsSecondary</property></widget></item>
                 <item row="2" column="2"><widget class="QPushButton" name="btnOpenDataDirectory"><property name="text"><string>打开目录</string></property></widget></item>
                 <item row="3" column="0"><widget class="QLabel" name="labelSettingsLastSavedCaption"><property name="text"><string>最近保存时间</string></property><property name="class">settingsFieldLabel</property></widget></item>
