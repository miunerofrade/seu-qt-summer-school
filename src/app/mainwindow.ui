}

QLabel#labelUserModeValue {
    color: #2F3033;
    font-size: 13px;
    font-weight: 600;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    color: #2F3033;
    font-size: 13px;
    text-align: left;
}

QToolButton:hover {
    background-color: #E2E3E6;
    color: #2F3033;
}

QToolButton:checked {
    background-color: #0A84FF;
    color: white;
    font-weight: 600;
}

QToolButton:checked:hover {
    background-color: #0A84FF;
    color: white;
}

QToolButton:pressed {
    background-color: #0071E3;
    color: white;
}

/* 日期栏只保留 QDateEdit 外层边框，内部编辑框不重复绘制。 */
QDateEdit QLineEdit {
    border: none;
    border-radius: 0;
    background: transparent;
}</string>
