        <string notr="true">QWidget#pagePassenger {
    background-color: #FFFFFF;
}

QLabel#labelPassengerTitle {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QWidget#passengerToolbar {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QTableView#tablePassengers {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    color: #2F3033;
    gridline-color: #ECEDEF;
}

QTableView#tablePassengers QHeaderView::section {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    color: #6E6E73;
