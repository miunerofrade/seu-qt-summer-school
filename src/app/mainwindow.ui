      <widget class="QWidget" name="pageOrder">
       <property name="styleSheet">
        <string notr="true">QWidget#pageOrder {
    background-color: #FFFFFF;
}

QLabel#labelOrderTitle {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QWidget#orderFilterCard,
QWidget#orderActionCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QTableWidget#tableOrders {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    color: #2F3033;
    gridline-color: #ECEDEF;
}

QTableWidget#tableOrders QHeaderView::section {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    color: #6E6E73;
    padding: 8px;
}

QWidget#orderFilterCard QDateEdit {
    min-height: 28px;
    max-height: 28px;
}

QPushButton#btnSearchOrders {
    background-color: #0A84FF;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    padding: 6px 16px;
}

QPushButton#btnSearchOrders:hover {
    background-color: #0071E3;
}</string>
