      <widget class="QWidget" name="pageStatistics">
       <property name="styleSheet">
        <string notr="true">QWidget#pageStatistics,
QWidget#statisticsScrollContent {
    background-color: #FFFFFF;
}

QLabel#labelStatisticsTitle {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QLabel#labelStatisticsSubtitle,
QLabel.statisticsCaption,
QLabel.statisticsPlaceholder {
    color: #6E6E73;
    font-size: 13px;
}

QWidget#statisticsFilterCard,
QFrame#metricTicketsCard,
QFrame#metricRefundsCard,
QFrame#metricRevenueCard,
QFrame#metricRateCard,
QFrame#statisticsTrendCard,
QFrame#statisticsSeatCard,
QWidget#statisticsTableCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QLabel.statisticsMetricIcon {
    background-color: #EAF3FF;
    border-radius: 22px;
    padding: 10px;
}

QLabel.statisticsMetricTitle {
    color: #6E6E73;
    font-size: 13px;
}

QLabel.statisticsMetricValue {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QLabel.statisticsSectionTitle {
    color: #1D1D1F;
    font-size: 15px;
    font-weight: 600;
}

QFrame.statisticsChartPlaceholder {
    background-color: #FAFBFC;
    border: 1px dashed #D8DDE6;
    border-radius: 6px;
}

QPushButton#btnStatisticsQuery {
    background-color: #0A84FF;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    padding: 6px 18px;
}

QPushButton#btnStatisticsQuery:hover {
    background-color: #0071E3;
}

QTableView#tableStatisticsTrains {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 0px;
    color: #2F3033;
    gridline-color: #ECEDEF;
}

QTableView#tableStatisticsTrains QHeaderView::section {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    color: #6E6E73;
    padding: 8px;
}</string>
       </property>
