       <property name="styleSheet">
        <string notr="true">QWidget#pageQuery {
    background-color: #FFFFFF;
}

QLabel#labelQueryTitle {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QWidget#queryCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QWidget#queryConditionsWidget,
QWidget#queryFiltersWidget {
    background-color: transparent;
    border: none;
}

QWidget#queryConditionsWidget QDateEdit,
QWidget#queryConditionsWidget QPushButton {
    min-height: 28px;
    max-height: 28px;
}

QTableView#tableTickets {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    color: #2F3033;
    gridline-color: #ECEDEF;
}

QTableView#tableTickets QHeaderView::section {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    color: #6E6E73;
    padding: 8px;
}

QTableView#tableTickets QHeaderView::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 6px;
}

QTableView#tableTickets QHeaderView::up-arrow {
    image: url(:/icons/chevron-up.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 6px;
}

QPushButton#btnBookTicket {
    background-color: #0A84FF;
    color: #FFFFFF;
}

QLineEdit#editPassengerSearch {
    min-width: 180px;
}

QLabel#labelDepartureStation,
QLabel#labelArrivalStation,
QLabel#labelTravelDate,
QLabel#labelSort {
    color: #6E6E73;
    font-size: 12px;
    font-weight: 500;
}</string>
