      <widget class="QWidget" name="pageAdmin">
       <property name="styleSheet">
         <string notr="true">QWidget#pageAdmin {
    background-color: #FFFFFF;
}

QLabel#labelAdminTitle {
    color: #1D1D1F;
    font-size: 22px;
    font-weight: 600;
}

QLabel#labelAdminSubtitle {
    color: #6E6E73;
    font-size: 13px;
}

QFrame#cardStationAdmin,
QFrame#cardTrainAdmin,
QFrame#cardScheduleAdmin,
QFrame#cardSeatAdmin {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QWidget#adminToolbar,
QWidget#adminRecentCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

QTableView#tableAdminRecent {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 0px;
    color: #2F3033;
    gridline-color: #ECEDEF;
}

QTableView#tableAdminRecent QHeaderView::section {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    color: #6E6E73;
    padding: 8px;
}

QLabel#labelRecentAdminTitle {
    color: #1D1D1F;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#btnRecentAdmin,
QPushButton#btnManageStations,
QPushButton#btnManageTrains,
QPushButton#btnManageSchedules,
QPushButton#btnManageSeats {
    background-color: #FFFFFF;
    border: 1px solid #D8DDE6;
    border-radius: 6px;
    color: #0A84FF;
    padding: 6px 14px;
}

QPushButton#btnAddAdminData {
    background-color: #0A84FF;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    padding: 6px 14px;
}

QLabel#labelStationAdminTitle,
QLabel#labelTrainAdminTitle,
QLabel#labelScheduleAdminTitle,
QLabel#labelSeatAdminTitle {
    color: #1D1D1F;
    font-size: 16px;
    font-weight: 600;
}

QLabel#labelStationAdminIcon,
QLabel#labelTrainAdminIcon,
QLabel#labelScheduleAdminIcon,
QLabel#labelSeatAdminIcon {
    background-color: #EAF3FF;
    border-radius: 8px;
    padding: 8px;
}

QLabel#labelStationAdminDescription,
QLabel#labelTrainAdminDescription,
QLabel#labelScheduleAdminDescription,
QLabel#labelSeatAdminDescription {
    color: #6E6E73;
    font-size: 13px;
}

QPushButton#btnAddAdminData:hover {
    background-color: #0071E3;
}</string>
